# Offline mode is deterministic and makes no network calls.
APP_MODE=offline
OFFLINE_FIXTURE_PATH=sample-data/inbox.json
OFFLINE_USER_ID=offline-user
OFFLINE_TENANT_ID=offline-tenant
CONFIRMATION_HMAC_SECRET=offline-development-key-change-before-live-123456
CONFIRMATION_TTL_SECONDS=120
ALLOWED_OPERATIONS=list,read,triage,draft
LOG_LEVEL=INFO

# Live mode: set APP_MODE=live, replace every value, and add "send" only
# after delegated Mail.Send/Agent 365 consent and governance review.
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Agent Identities cannot provide browser SSO. Register this separate SPA client,
# add the app origin as its SPA redirect URI, and preauthorize access_as_user.
# MSAL Browser uses authorization-code + PKCE.
# ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_AUDIENCE=api://<blueprint-app-id>
# ENTRA_API_SCOPE=api://<blueprint-app-id>/access_as_user
# Comma-separated callers accepted in token azp/appid; must include the SPA ID.
# ENTRA_ALLOWED_CLIENT_IDS=<spa-client-id>
# ENTRA_BLUEPRINT_APP_ID=00000000-0000-0000-0000-000000000000
# ENTRA_AGENT_IDENTITY_APP_ID=00000000-0000-0000-0000-000000000000
# ENTRA_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# The pinned MSAL Browser script is loaded dynamically only in live mode.
# MSAL_BROWSER_CDN_URL=https://alcdn.msauth.net/browser/4.25.0/js/msal-browser.min.js
# ACA Sandbox runs one process, so direct managed-identity fmi_path exchange is default.
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# OBO_BROKER_MODE=direct_fmi
# Optional only when a separately deployed localhost Agent ID sidecar exists:
# OBO_BROKER_URL=http://127.0.0.1:8080
# Use the generated manifest/setup values; the current catalog URL shape is:
# A365_MAILTOOLS_URL=https://agent365.svc.cloud.microsoft/agents/tenants/<tenant-id>/servers/mcp_MailTools
# A365_MAILTOOLS_AUDIENCE=api://05879165-0320-489e-b644-f72b33f3edf0
# A365_MAILTOOLS_SCOPE=api://05879165-0320-489e-b644-f72b33f3edf0/.default
# FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project-name>
# FOUNDRY_MODEL_DEPLOYMENT=<deployment-name>
# Enables content-free local spans. Use the Agent 365 setup skill to configure
# the tenant-authenticated exporter before expecting admin-center visibility.
# ENABLE_OBSERVABILITY=true
# Foundry uses the same AZURE_CLIENT_ID user-assigned managed identity by default.
# Local live development only; never enable in deployed environments.
# ALLOW_DEFAULT_AZURE_CREDENTIAL_LOCAL_DEVELOPMENT=false
# ALLOWED_OPERATIONS=list,read,triage,draft,send
# CONFIRMATION_HMAC_SECRET=<at-least-32-random-bytes-and-not-the-offline-default>
