{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "enableFoundry": {
      "value": "${AZURE_ENABLE_FOUNDRY=true}"
    },
    "modelCapacity": {
      "value": "${AZURE_AI_MODEL_CAPACITY=10}"
    },
    "sandboxOperatorPrincipalId": {
      "value": "${ACA_SANDBOX_OPERATOR_PRINCIPAL_ID=}"
    }
  }
}
